# Conclave Environment Variables
# Copy to .env for local development

# PostgreSQL connection string
DATABASE_URL=postgres://conclave:conclave@localhost:5432/conclave

# JWT secret (auto-generated on Render; set a random string for local dev)
CONCLAVE_JWT_SECRET=conclave-dev-secret-change-in-production

# Server
PORT=3000
NODE_ENV=development
CONCLAVE_MODE=local

# LLM provider keys (used by fleet reviewer daemon)
OLLAMA_KEY=
OPENAI_API_KEY=