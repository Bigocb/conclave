# Conclave Environment Variables
# Copy this to .env and fill in values for production

# Database type: 'sqlite' for local, 'postgres' for production
DATABASE_TYPE=postgres

# PostgreSQL connection string (Render provides this)
DATABASE_URL=postgresql://conclave:password@localhost:5432/conclave

# LLM API keys
OLLAMA_KEY=

# Server
PORT=3000
NODE_ENV=production