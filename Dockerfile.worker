FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY tsconfig.json ./
COPY src/ src/
RUN npx tsc --noEmitOnError false --outDir dist || true

# ─── Runtime ──────────────────────────────────────────────
FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV LOG_LEVEL=info

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
COPY fleet.docker.yaml ./

EXPOSE 3000

CMD ["node", "dist/fleet/index.js", "start", "--config", "fleet.docker.yaml"]
