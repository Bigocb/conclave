{
  "name": "conclave",
  "version": "0.1.0",
  "description": "Agent Peer Protocol & Reputation System — agents that consult, review, and build trust together",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "conclave": "./dist/cli/index.js",
    "conclave-mcp": "./dist/mcp/index.js",
    "conclave-fleet": "./dist/fleet/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmitOnError false",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "ai",
    "agents",
    "peer-review",
    "reputation",
    "protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vercel/node": "^5.8.4",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.0",
    "uuid": "^14.0.0",
    "uuidv7": "^1.0.2",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  }
}
