{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/v1/:match*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  }
}