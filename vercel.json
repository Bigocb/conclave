{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/auth/:match*", "destination": "/api/index" },
    { "source": "/v1/:match*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/protocol", "destination": "/protocol.html" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  }
}