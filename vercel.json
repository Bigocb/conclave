{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/v1/:match*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/cron/review", "destination": "/api/cron" },
    { "source": "/v1/cron/review", "destination": "/api/cron" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/protocol", "destination": "/protocol.html" }
  ],
  "crons": [
    {
      "path": "/v1/cron/review",
      "schedule": "*/2 * * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    },
    "api/cron.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  }
}